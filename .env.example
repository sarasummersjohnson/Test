# Anthropic API key — used server-side only (API routes), never exposed to the browser.
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call /api/generate cross-origin
# (e.g. your Squarespace domain, https://www.example.org). Leave blank for
# local dev / same-origin (iframe) usage.
ALLOWED_ORIGIN=

# Upstash Redis credentials, used to track per-access-code usage counts for
# the /admin view. If you add the "Upstash" integration from the Vercel
# Marketplace, these (or the KV_REST_API_* equivalents) are populated for you
# automatically. For local dev, create a free database at upstash.com and
# paste its REST URL/token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
